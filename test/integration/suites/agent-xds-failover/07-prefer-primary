#!/bin/bash

source ./_common.sh

# Both servers are up. The xDS policy places spire-server-1 at priority 0, so
# the live JWT fetch must be served by it.
want=$(server-jwt-kid spire-server-1)
kid=$(fetch-jwt-kid "$(unique-audience)")
if [ "${kid}" != "${want}" ]; then
    fail-now "expected kid ${want} (spire-server-1), got ${kid}"
fi
log-info "both servers up: JWT-SVID issued by spire-server-1 (kid=${kid})"
