#!/bin/bash

for format in pretty json; do
  for keySigningAlgCombo in ec-p256:ES256 ec-p384:ES384 rsa-2048:RS256 rsa-4096:RS512; do
    keyType=$(echo $keySigningAlgCombo | cut -f 1 -d ':')
    signingAlgorithm=$(echo $keySigningAlgCombo | cut -f 2 -d ':')

    docker compose exec -T -e SPIRE_SERVER_FFLAGS="wit-svid" spire-server /opt/spire/bin/spire-server \
      wit mint -spiffeID "spiffe://domain.test/workload" \
      -keyType "${keyType}" \
      -signingAlgorithm "${signingAlgorithm}" \
      -output ${format} || fail-now "could not mint WIT-SVID using key type '${keyType}' and signing algorithm '${signingAlgorithm}'"
  done
done

# Check that the JSON output carries the token and the matching private key
MINTED=$(docker compose exec -T -e SPIRE_SERVER_FFLAGS="wit-svid" spire-server /opt/spire/bin/spire-server \
  wit mint -spiffeID "spiffe://domain.test/workload" -output json) || fail-now "could not mint WIT-SVID"
echo "${MINTED}" | jq -e '.svid.token | length != 0' > /dev/null || fail-now "minted WIT-SVID is missing the token"
echo "${MINTED}" | jq -e '.private_key | fromjson | .kty == "EC"' > /dev/null || fail-now "minted WIT-SVID is missing the private key"

# Check that the SPIFFE ID is required
docker compose exec -T -e SPIRE_SERVER_FFLAGS="wit-svid" spire-server /opt/spire/bin/spire-server \
  wit mint && fail-now "could mint WIT-SVID without a SPIFFE ID"

# Check an invalid SPIFFE ID
docker compose exec -T -e SPIRE_SERVER_FFLAGS="wit-svid" spire-server /opt/spire/bin/spire-server \
  wit mint -spiffeID "not-a-spiffe-id" && fail-now "could mint WIT-SVID with an invalid SPIFFE ID"

# Check an invalid key type
docker compose exec -T -e SPIRE_SERVER_FFLAGS="wit-svid" spire-server /opt/spire/bin/spire-server \
  wit mint -spiffeID "spiffe://domain.test/workload" \
  -keyType "ec-p123" && fail-now "could mint WIT-SVID with invalid key type"

# Check an invalid signing algorithm
docker compose exec -T -e SPIRE_SERVER_FFLAGS="wit-svid" spire-server /opt/spire/bin/spire-server \
  wit mint -spiffeID "spiffe://domain.test/workload" \
  -keyType "ec-p256" \
  -signingAlgorithm "ES123" && fail-now "could mint WIT-SVID with invalid signing algorithm"

# Check an invalid signing algorithm for the specified key type
docker compose exec -T -e SPIRE_SERVER_FFLAGS="wit-svid" spire-server /opt/spire/bin/spire-server \
  wit mint -spiffeID "spiffe://domain.test/workload" \
  -keyType "ec-p256" \
  -signingAlgorithm "RS256" && fail-now "could mint WIT-SVID with invalid signing algorithm for key type"

# Check that we can specify a custom TTL
docker compose exec -T -e SPIRE_SERVER_FFLAGS="wit-svid" spire-server /opt/spire/bin/spire-server \
  wit mint -spiffeID "spiffe://domain.test/workload" -ttl 60s || fail-now "could not mint WIT-SVID with custom TTL"

# Check that WIT-SVID can be written to a directory
docker compose exec -T -e SPIRE_SERVER_FFLAGS="wit-svid" spire-server /opt/spire/bin/spire-server \
  wit mint -spiffeID "spiffe://domain.test/workload" -write /tmp || fail-now "could not write WIT-SVID to /tmp"
