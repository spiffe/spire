#!/bin/bash

ENTRYCOUNT=3

fetch-wit() {
  docker compose exec -u 1001 -T spire-agent \
    /opt/spire/bin/spire-agent api fetch wit \
    -socketPath /opt/spire/sockets/workload_api.sock "$@"
}

# The agent mints WIT-SVIDs asynchronously once the workload subscribes, so the
# first responses may carry fewer SVIDs than there are entries.
wait-for-wit-svid-count() {
  local expected=$1
  local MAXCHECKS=30
  local CHECKINTERVAL=1
  for ((i=1;i<=MAXCHECKS;i++)); do
    OUTPUT=$(fetch-wit -output json) || fail-now "WIT-SVID fetch failed: $OUTPUT"
    COUNT=$(echo "${OUTPUT}" | jq '.[0].svids | length')
    if [ "$COUNT" -eq "$expected" ]; then
      log-info "Expected $expected WIT-SVIDs and received $COUNT for uid 1001"
      return 0
    fi
    log-info "waiting for $expected WIT-SVIDs, received $COUNT ($i of $MAXCHECKS max)..."
    sleep "${CHECKINTERVAL}"
  done

  fail-now "WIT-SVID check failed. Expected $expected WIT-SVIDs but received $COUNT for uid 1001"
}

wait-for-wit-svid-count $ENTRYCOUNT

# Each WIT-SVID must carry a token, the corresponding key and the entry hint
for ((m=1;m<=$ENTRYCOUNT;m++)); do
  echo "${OUTPUT}" | jq -e --arg id "spiffe://domain.test/workload-$m" \
    '.[0].svids[] | select(.spiffe_id == $id) | (.wit_svid | length != 0) and (.wit_svid_key | fromjson | .kty != null)' > /dev/null \
    || fail-now "WIT-SVID for spiffe://domain.test/workload-$m is missing its token or key"
  echo "${OUTPUT}" | jq -e --arg id "spiffe://domain.test/workload-$m" --arg hint "wit-$m" \
    '.[0].svids[] | select(.spiffe_id == $id) | .hint == $hint' > /dev/null \
    || fail-now "WIT-SVID for spiffe://domain.test/workload-$m is missing its hint"
done

# The WIT bundle for the trust domain must be returned alongside the SVIDs
echo "${OUTPUT}" | jq -e '.[1].bundles["spiffe://domain.test"] | length != 0' > /dev/null \
  || fail-now "WIT bundle for the trust domain was not returned"

# Fetching with a SPIFFE ID must only return the matching WIT-SVID
FILTERED=$(fetch-wit -output json -spiffeID "spiffe://domain.test/workload-2") || fail-now "filtered WIT-SVID fetch failed"
echo "${FILTERED}" | jq -e '.[0].svids | length == 1 and (.[0].spiffe_id == "spiffe://domain.test/workload-2")' > /dev/null \
  || fail-now "filtered WIT-SVID fetch did not return only spiffe://domain.test/workload-2"

# An unknown SPIFFE ID must not match any identity
if UNKNOWN=$(fetch-wit -spiffeID "spiffe://domain.test/unknown" 2>&1); then
  fail-now "WIT-SVID fetch for an unknown SPIFFE ID should have failed"
fi
echo "${UNKNOWN}" | grep -q "no identity issued" \
  || fail-now "WIT-SVID fetch for an unknown SPIFFE ID expected a 'no identity issued' error, but got: $UNKNOWN"

# The pretty output must list every WIT-SVID
PRETTYCOUNT=$(fetch-wit | grep -c "^token(spiffe://domain.test/workload-" || true)
if [ "$PRETTYCOUNT" -ne "$ENTRYCOUNT" ]; then
  fail-now "WIT-SVID check failed. Expected $ENTRYCOUNT WIT-SVIDs in pretty output but received $PRETTYCOUNT"
fi

# A workload without matching entries must not receive any WIT-SVID
if NOENTRIES=$(docker compose exec -u 1002 -T spire-agent \
  /opt/spire/bin/spire-agent api fetch wit \
  -socketPath /opt/spire/sockets/workload_api.sock 2>&1); then
  fail-now "WIT-SVID fetch for uid 1002 should have failed"
fi
echo "${NOENTRIES}" | grep -q "no identity issued" \
  || fail-now "WIT-SVID fetch for uid 1002 expected a 'no identity issued' error, but got: $NOENTRIES"
