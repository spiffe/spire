#!/bin/bash

set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

PKGDIR="${REPODIR}/pkg/server/datastore/sqlstore"

log-debug "building mysql test harness..."
(cd "${PKGDIR}"; go test -c -o "${DIR}"/mysql.test -ldflags "-X github.com/spiffe/spire/pkg/server/datastore/sqlstore.TestDialect=mysql -X github.com/spiffe/spire/pkg/server/datastore/sqlstore.TestConnString=spire:test@tcp(localhost:9999)/spire?parseTime=true -X github.com/spiffe/spire/pkg/server/datastore/sqlstore.TestROConnString=spire:test@tcp(localhost:9999)/spire?parseTime=true")

log-debug "building mysql test harness for the gorm v2 datastore..."
(cd "${REPODIR}/pkg/server/datastore/sqlstorev2"; go test -c -o "${DIR}"/mysql-v2.test -ldflags "-X github.com/spiffe/spire/pkg/server/datastore/sqlstorev2.TestDialect=mysql -X github.com/spiffe/spire/pkg/server/datastore/sqlstorev2.TestConnString=spire:test@tcp(localhost:9999)/spire?parseTime=true")

log-debug "copying over test data..."
cp -r "${PKGDIR}"/testdata .

log-debug "pulling mysql docker images..."
retry docker compose pull
