#!/bin/bash

set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

PKGDIR="${REPODIR}/pkg/server/datastore/sqlstore"

log-debug "building postgres replication test harness..."
(cd "${PKGDIR}"; go test -c -o "${DIR}"/postgres.replication.test -ldflags "-X github.com/spiffe/spire/pkg/server/datastore/sqlstore.TestDialect=postgres")

log-debug "copying over test data..."
cp -r "${PKGDIR}"/testdata .

log-debug "pulling postgres docker images..."
retry docker compose pull
