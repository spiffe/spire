#!/bin/bash

VERSIONS=(13 14 15 16 17 18)

# Each version's principal and replica listen on their own host ports (see
# docker-compose.yaml) so the tests can run against all versions at the same
# time.
conn-string() {
    echo "postgres://postgres:password@localhost:99$1/postgres?sslmode=disable"
}

ro-conn-string() {
    echo "postgres://postgres:password@localhost:100$1/postgres?sslmode=disable"
}

wait-ready() {
    local service=$1

    # Wait up to two minutes for postgres to be available. It should come up
    # pretty quick on developer machines but CI/CD is slow.
    local max_checks=40
    local check_interval=3
    for ((i=1;i<=max_checks;i++)); do
        log-info "waiting for ${service} ($i of $max_checks max)..."
        if docker compose exec -T "${service}" pg_isready -h localhost -U postgres >/dev/null; then
            return 0
        fi
        sleep "${check_interval}"
    done

    fail-now "timed out waiting for ${service} to be ready"
}

services=()
for version in "${VERSIONS[@]}"; do
    services+=("postgres-${version}-readwrite" "postgres-${version}-readonly")
done

docker-up "${services[@]}"
for service in "${services[@]}"; do
    wait-ready "${service}"
done

runs=()
for version in "${VERSIONS[@]}"; do
    runs+=("postgres-${version}=SQLSTORE_TEST_CONN_STRING='$(conn-string "${version}")' SQLSTORE_TEST_RO_CONN_STRING='$(ro-conn-string "${version}")' ./postgres.replication.test")
done

log-info "running tests against ${services[*]}..."
run-concurrently "${runs[@]}"

docker-stop "${services[@]}"
