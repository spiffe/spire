#!/bin/bash

set -e -o pipefail

source init-kubectl

# ── Configure the KMS-provisioned root CA cert UID ─────────────────────
# Not all KMIP servers auto-populate the Link attributes the plugin's CA-cert
# auto-discovery relies on (e.g. PublicKeyLink/CertificateLink from
# CreateKeyPair/Certify), so explicitly configure ca_cert_uid with the real
# UID captured by 01-setup-kms instead of depending on auto-discovery here.
[ -f "${RUNDIR}/ca-cert-uid" ] || fail-now "missing ca-cert-uid file written by 01-setup-kms"
CA_CERT_UID="$(cat "${RUNDIR}/ca-cert-uid")"
sed -i.bak "s/ca_key_uid       = \"spire-upstream-ca-key\"/&\n          ca_cert_uid      = \"${CA_CERT_UID}\"/" \
  conf/server/spire-server.yaml
rm -f conf/server/spire-server.yaml.bak

# ── Deploy SPIRE Server with kmip UpstreamAuthority ────────────────────
log-info "deploying SPIRE server..."
./bin/kubectl create namespace spire --dry-run=client -o yaml | ./bin/kubectl apply -f -
./bin/kubectl -n spire apply -f conf/server/

log-info "waiting for SPIRE server..."
./bin/kubectl -n spire rollout status deployment/spire-server --timeout=120s

# ── Verify SPIRE server is healthy (UpstreamAuthority signed the CA) ─────────
log-info "verifying SPIRE server health..."
./bin/kubectl -n spire exec deployment/spire-server -- \
  /opt/spire/bin/spire-server healthcheck

# ── Verify the UpstreamAuthority signed the intermediate CA via KMS ───────────
# Mint an X.509-SVID and verify its chain terminates at the pre-provisioned KMS
# root CA. This exercises the full UpstreamAuthority path (CSR → KMS Certify →
# returned chain), unlike a join token which only writes to the datastore.
log-info "minting an X.509-SVID to verify the upstream trust chain..."
MINT_OUT=$(./bin/kubectl -n spire exec deployment/spire-server -- \
  /opt/spire/bin/spire-server x509 mint \
    -spiffeID "spiffe://example.org/test-workload")

# Extract the root CA from the bundle ("Root CAs:" section) and check its CN.
ROOT_CN=$(printf '%s\n' "${MINT_OUT}" \
  | sed -n '/Root CAs:/,/^$/p' \
  | sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' \
  | openssl x509 -noout -subject \
  | sed -n 's/.*CN *= *//p')

if [[ "${ROOT_CN}" != *"SPIRE Upstream CA"* ]]; then
  fail-now "upstream root CA is not the KMS-provisioned root (got CN='${ROOT_CN}')"
fi

log-info "SVID chain verified against the KMS root CA (CN='${ROOT_CN}')"
log-info "SUCCESS: SPIRE UpstreamAuthority 'kmip' signed the CA via KMS Certify"
export SUCCESS=1
